{
  "name": "lms-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "watch": "tsx src/main.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "setup": "tsx src/setup/cli.ts",
    "setup:dry-run": "tsx src/setup/cli.ts --dry-run --non-interactive",
    "setup:doctor": "tsx src/setup/cli.ts doctor",
    "setup:check": "node scripts/setup-check.mjs",
    "setup:verify": "pnpm setup:check && pnpm verify:config && pnpm verify:kv && pnpm verify:telegram && pnpm verify:calendar && pnpm verify:moodle",
    "verify:kv": "tsx src/verify-kv.ts",
    "verify:telegram": "tsx src/verify-telegram.ts",
    "verify:config": "tsx src/verify-config.ts",
    "verify:calendar": "tsx src/verify-calendar.ts",
    "verify:moodle": "tsx src/verify-moodle.ts",
    "verify:status": "tsx src/verify-status.ts",
    "notify:deploy": "tsx src/deploy-notify.ts",
    "scheduler:check": "wrangler deploy --dry-run",
    "scheduler:deploy": "wrangler deploy",
    "scheduler:logs": "wrangler tail lms-watcher-scheduler"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "boxen": "^8.0.1",
    "dotenv": "latest",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "ical.js": "latest",
    "open": "^11.0.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "playwright": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "^4.105.0"
  }
}
